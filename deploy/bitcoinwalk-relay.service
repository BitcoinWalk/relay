[Unit]
Description=BitcoinWalk Khatru staging relay
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
StateDirectory=bitcoinwalk-relay
StateDirectoryMode=0700
WorkingDirectory=/var/lib/bitcoinwalk-relay
ExecStart=/opt/bitcoinwalk-relay/bitcoinwalk-relay
Environment=RELAY_LISTEN=127.0.0.1:3334
Environment=RELAY_DB=/var/lib/bitcoinwalk-relay/events.db
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
