[Unit]
Description=BitcoinWalk isolated chat staging (not legacy chat)
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
StateDirectory=bitcoinwalk-chat-staging
StateDirectoryMode=0700
WorkingDirectory=/var/lib/bitcoinwalk-chat-staging
ExecStart=/opt/bitcoinwalk-chat-staging/bitcoinwalk-relay
Environment=RELAY_CHAT_MODE=staging
Environment=RELAY_CHAT_LISTEN=127.0.0.1:3335
Environment=RELAY_CHAT_DB=/var/lib/bitcoinwalk-chat-staging/chat.db
Environment=RELAY_CHAT_KEY_FILE=%d/relay-key
# Required operator configuration: RELAY_CHAT_URL=wss://approved-staging-host
EnvironmentFile=/etc/bitcoinwalk-chat-staging/public.conf
LoadCredential=relay-key:/etc/bitcoinwalk-chat-staging/relay-key
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
