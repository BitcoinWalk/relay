[Unit]
Description=BitcoinWalk isolated first-walk replication receiver rehearsal
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
StateDirectory=bitcoinwalk-replica-firstwalk
StateDirectoryMode=0700
WorkingDirectory=/var/lib/bitcoinwalk-replica-firstwalk
ExecStart=/opt/bitcoinwalk-replica-firstwalk/bitcoinwalk-relay
Environment=RELAY_LISTEN=127.0.0.1:3342
Environment=RELAY_DB=/var/lib/bitcoinwalk-replica-firstwalk/events.db
Environment=RELAY_ORGANIZER_MODE=true
Environment="RELAY_NAME=BitcoinWalk first-walk replication rehearsal"
Environment="RELAY_DESCRIPTION=Isolated staging receiver for paid-city first-walk replication acceptance."
EnvironmentFile=/etc/bitcoinwalk-replication/receiver-firstwalk.conf
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
