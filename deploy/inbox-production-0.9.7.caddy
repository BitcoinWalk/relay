# Append this complete site block only after inbox.bitcoinwalk.org resolves to
# this server. The production relay remains bound to loopback port 3349.
inbox.bitcoinwalk.org {
	@relay {
		header Upgrade websocket
	}
	handle @relay {
		reverse_proxy 127.0.0.1:3349 {
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Forwarded-Host inbox.bitcoinwalk.org
			header_up X-Forwarded-Proto https
			header_up -Forwarded
		}
	}
	@info {
		header Accept *application/nostr+json*
	}
	handle @info {
		reverse_proxy 127.0.0.1:3349
	}
	handle /healthz {
		reverse_proxy 127.0.0.1:3349
	}
	handle {
		reverse_proxy 127.0.0.1:3349
	}
}
